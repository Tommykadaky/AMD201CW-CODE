# Copy this file to "infra/.env" and change the passwords. NEVER commit .env (it is in .gitignore).

# ----- Needed for everything (also for "docker compose up -d" with only Postgres + RabbitMQ) -----
POSTGRES_USER=treeo
POSTGRES_PASSWORD=doi_mat_khau_nay
RABBITMQ_USER=treeo
RABBITMQ_PASSWORD=doi_mat_khau_nay

# ----- Only for the full system in Docker (docker compose --profile app ...) -----
# Shared secret that signs login tokens. Local default works; on a real server use 32+ random characters.
JWT_KEY=
# Admin account created on first start
ADMIN_EMAIL=admin@treeo.local
ADMIN_PASSWORD=Admin@12345
# Google Gemini key for TreeO AI (free at aistudio.google.com). Empty = AI answers "not set up yet".
GEMINI_API_KEY=
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Forum sample posts (set false on a real server)
SEED_SAMPLE_POSTS=true
# Real password-reset emails (optional; empty = codes are printed in the identity container log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Websites allowed to call the API from a browser (Expo web runs on 8081)
CORS_ORIGIN_1=http://localhost:8081
CORS_ORIGIN_2=http://localhost:19006
CORS_ORIGIN_3=http://localhost:5173
# Gateway port on this machine
GATEWAY_PORT=5100

# ----- Only on the server when pulling images built by GitHub Actions -----
# IMAGE_PREFIX=ghcr.io/<github-owner-lowercase>/treeo
# IMAGE_TAG=latest
