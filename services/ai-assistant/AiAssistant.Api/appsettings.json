{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "treeo-identity",
    "Audience": "treeo"
  },
  "Gemini": {
    "Model": "gemini-3.6-flash",
    "MaxTokens": 2048,
    "ThinkingLevel": "",
    "BaseUrl": "https://generativelanguage.googleapis.com/"
  },
  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 700,
    "BaseUrl": "https://api.anthropic.com/"
  },
  "Ai": {
    "Provider": "gemini",
    "RequestsPerMinute": 10
  },
  "Cors": {
    "Origins": [ "http://localhost:8081", "http://localhost:19006", "http://localhost:5173" ]
  }
}
