{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "AuthPerMinute": 10,
    "DefaultPerMinute": 300
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-register": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-forgot-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/forgot-password" }
      },
      "auth-reset-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/reset-password" }
      },
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/auth/{**rest}" }
      },
      "admin": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/admin/{**rest}" }
      },
      "forum": {
        "ClusterId": "forum",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/forum/{**rest}" }
      },
      "garden": {
        "ClusterId": "garden",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/garden/{**rest}" }
      },
      "weather": {
        "ClusterId": "reminder",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/weather/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/notifications/{**rest}" }
      },
      "ai": {
        "ClusterId": "ai",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/ai/{**rest}" }
      },
      "sensors": {
        "ClusterId": "sensor",
        "RateLimiterPolicy": "default",
        "Match": { "Path": "/api/sensors/{**rest}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "main": { "Address": "http://localhost:5101" } }
      },
      "forum": {
        "Destinations": { "main": { "Address": "http://localhost:5107" } }
      },
      "garden": {
        "Destinations": { "main": { "Address": "http://localhost:5103" } }
      },
      "reminder": {
        "Destinations": { "main": { "Address": "http://localhost:5104" } }
      },
      "notification": {
        "Destinations": { "main": { "Address": "http://localhost:5105" } }
      },
      "ai": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": { "main": { "Address": "http://localhost:5106" } }
      },
      "sensor": {
        "Destinations": { "main": { "Address": "http://localhost:5182" } }
      }
    }
  }
}
