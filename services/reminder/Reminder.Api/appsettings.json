{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "treeo-identity",
    "Audience": "treeo"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "treeo"
  },
  "Weather": {
    "BaseUrl": "https://api.open-meteo.com/",
    "DefaultName": "Ho Chi Minh City",
    "DefaultLatitude": 10.8231,
    "DefaultLongitude": 106.6297,
    "HeatwaveThresholdC": 35,
    "CacheMinutes": 10
  },
  "Cors": {
    "Origins": [ "http://localhost:8081", "http://localhost:19006", "http://localhost:5173" ]
  }
}
